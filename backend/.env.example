NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartbank_db
DB_USER=postgres
DB_PASSWORD=YourPostgresPasswordHere
# Optional: Use a single DATABASE_URL instead of host/port/user/password
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=
# Optional: enable SSL when connecting to hosted Postgres (true/false)
DB_SSL=false

JWT_SECRET=smartbank_jwt_secret_minimum_32_chars_here
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=smartbank_refresh_secret_minimum_32_chars
JWT_REFRESH_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

AI_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
